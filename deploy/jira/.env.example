# Lấy 3 giá trị này từ: terraform output database_private_uri
# URI dạng: postgresql://user:password@host:port/dbname?sslmode=require
# Tách ra thành JDBC URL + user + password riêng như dưới đây.

ATL_JDBC_URL=jdbc:postgresql://<db-private-host>:<port>/<dbname>?sslmode=require
ATL_JDBC_USER=<user>
ATL_JDBC_PASSWORD=<password>
