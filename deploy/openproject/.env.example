# Lấy từ: terraform output -raw database_private_uri (thêm &pool=20&encoding=unicode&reconnect=true)
DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=require&pool=20&encoding=unicode&reconnect=true

# Địa chỉ Tailscale IP:port của droplet, dùng để truy cập
OPENPROJECT_HOST__NAME=100.64.0.2:8080

# Domain public qua Cloudflare Tunnel (cho GitHub webhook gọi vào) — không bắt buộc nếu không dùng GitHub Integration
OPENPROJECT_ADDITIONAL_HOST_NAMES=""

# Generate: tr -dc 'a-f0-9' < /dev/urandom | head -c 128
SECRET_KEY_BASE=<random-128-hex-chars>

# Lấy từ Cloudflare Zero Trust dashboard: Networks > Tunnels > Create/Edit tunnel > Docker > copy phần sau --token
CLOUDFLARE_TUNNEL_TOKEN=<token-tu-cloudflare-dashboard>
